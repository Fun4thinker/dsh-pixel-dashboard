{
  "name": "dsh-pixel-dashboard",
  "version": "3.0.0",
  "description": "DSH 用量与费用看板：多厂商模型单价（内置官方价 + 按提供商分页自定义）、Token 与消费趋势、模型分布与费用明细、官方账号余额与套餐额度、会话内「费用」标签页、侧栏时段指示灯与输入框费用条、任务类系统通知。不改产品界面配色",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis-plugin",
    "dashboard",
    "usage",
    "cost",
    "agent-team",
    "notification",
    "alert"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fun4thinker/dsh-pixel-dashboard.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "verify": "node tools/verify.mjs",
    "test": "node tools/test.mjs && node tools/test-patch-layer.mjs",
    "preflight": "node tools/preflight.mjs",
    "render-check": "node tools/render-check.mjs",
    "install:official": "node tools/install-official.mjs",
    "doctor": "node tools/doctor.mjs",
    "pack": "npm pack",
    "prepublishOnly": "node tools/build.mjs && node tools/test.mjs && node tools/preflight.mjs",
    "sync:desktop": "node tools/sync-desktop.mjs"
  }
}
