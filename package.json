{
  "name": "dsh-pixel-dashboard",
  "version": "2.8.0",
  "description": "DSH 像素风皮肤与用量看板：马卡龙配色主题、Token 趋势、模型分布、活跃日历、费用估算与时段倒计时、侧栏时段指示灯、会话费用条、余额与套餐额度预警、任务完成/失败/等待授权的系统通知",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis-plugin",
    "dashboard",
    "usage",
    "theme",
    "notification",
    "alert"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fun4thinker/dsh-pixel-dashboard.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "verify": "node tools/verify.mjs",
    "test": "node tools/test.mjs && node tools/test-patch-layer.mjs",
    "preflight": "node tools/preflight.mjs",
    "render-check": "node tools/render-check.mjs",
    "install:official": "node tools/install-official.mjs",
    "doctor": "node tools/doctor.mjs",
    "pack": "npm pack"
  }
}
