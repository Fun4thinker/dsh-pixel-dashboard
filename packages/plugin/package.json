{
  "name": "dsh-pixel-dashboard",
  "version": "2.0.0",
  "description": "DSH 像素风皮肤与用量看板：马卡龙配色主题、Token 趋势、模型分布、活跃日历、费用估算与时段倒计时、会话费用条",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "dashboard",
    "usage",
    "theme"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  }
}
